{
  "name": "openclaw-max-plus",
  "version": "0.7.0",
  "description": "MAX messenger channel plugin for OpenClaw",
  "type": "module",
  "main": "./dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MissiaL/openclaw-max-plus.git"
  },
  "homepage": "https://github.com/MissiaL/openclaw-max-plus#readme",
  "bugs": {
    "url": "https://github.com/MissiaL/openclaw-max-plus/issues"
  },
  "scripts": {
    "build": "rm -rf dist-ts dist/src dist/certs && tsc --noEmit false --noEmitOnError false --outDir dist-ts && mkdir -p dist/src && cp dist-ts/index.js dist/index.js && cp dist-ts/src/*.js dist/src/ && cp -R certs dist/certs",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api": "node --input-type=module ./scripts/test-api.mjs"
  },
  "files": [
    "dist/",
    "src/",
    "scripts/",
    "certs/",
    "openclaw.plugin.json",
    "README.md",
    "SKILL.md",
    "LICENSE",
    "!**/*.test.ts",
    "!**/*.test.js"
  ],
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "channel": {
      "id": "max",
      "label": "MAX",
      "selectionLabel": "MAX (max.ru)",
      "docsPath": "/channels/max",
      "docsLabel": "max",
      "blurb": "MAX messenger channel (max.ru Bot API)."
    },
    "install": {
      "minHostVersion": ">=2026.10.4"
    },
    "compat": {
      "pluginApi": ">=2026.10.4",
      "minGatewayVersion": "2026.10.4"
    },
    "build": {
      "openclawVersion": "2026.10.4",
      "pluginSdkVersion": "2026.10.4"
    }
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "openclaw": "2026.10.4",
    "prettier": "^3.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.4"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": false
    }
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  }
}
